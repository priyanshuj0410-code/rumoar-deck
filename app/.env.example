# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by scripts/seed-catalog.mjs. Never add this to the deployment.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini — aistudio.google.com/apikey. Server only, never sent to the browser.
GEMINI_API_KEY=
# Stylist conversation and wardrobe photo reading.
GEMINI_TEXT_MODEL=gemini-3.6-flash
# Reveal shots and PDP try-on (Nano Banana 2).
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Absolute origin, used for auth redirects. Leave unset on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
